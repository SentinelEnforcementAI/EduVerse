# Sentinel Watch — environment variables
#
# Copy this file to .env and fill in values. Never commit .env.
# Real secrets (Wonde keys, production credentials) live in .env only.

# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection string. The default matches docker-compose.yml exactly,
# so for local dev you can use it as-is.
DATABASE_URL="postgresql://sentinel:sentinel_dev_password@localhost:5432/sentinel_watch"

# ── Redis ───────────────────────────────────────────────────────────────────
# Redis connection string. Matches docker-compose.yml. Not used by code yet —
# reserved for the Wonde sync queue (build step 4).
REDIS_URL="redis://localhost:6379"

# ── Application ─────────────────────────────────────────────────────────────
# Public base URL of the app. Used to build magic sign-in links.
# Local dev: http://localhost:3000. Production: the deployed URL (eu-west-2).
APP_URL="http://localhost:3000"

# ── Email ───────────────────────────────────────────────────────────────────
# How magic link emails are delivered.
#   console — prints the link to the server terminal (local dev only)
# CTO-DECISION: production provider. AWS SES in eu-west-2 keeps email inside
# UK infrastructure.
EMAIL_TRANSPORT="console"

# ── Wonde ───────────────────────────────────────────────────────────────────
# Register at wonde.com/developers for sandbox access — you get a test school
# and an API key. Sandbox first; Downlands and Patcham connect only after
# signed DPAs. Leave blank until then: everything except a real sync works
# without these.
WONDE_API_KEY=""
# The Wonde school id (e.g. A1930499837) a tenant links to on first sync.
WONDE_SCHOOL_ID=""
# Override only if Wonde's base URL differs (defaults to the public API).
# WONDE_BASE_URL="https://api.wonde.com"
