# Worker image: Wonde sync + scheduled rules runs, plus one-off commands
# (migrations, user provisioning). Build from the repo root:
#   docker build -f Dockerfile.worker -t sentinel-watch-worker .
FROM node:22-slim
# Prisma's engines need OpenSSL, which slim images do not ship.
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
# Bake pnpm into a world-readable corepack cache at build time — the
# runtime user has no writable home, so corepack must never download.
ENV COREPACK_HOME=/opt/corepack
RUN corepack enable pnpm && corepack install --global pnpm@10.33.0
WORKDIR /repo

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/
COPY packages/db/package.json packages/db/
COPY packages/rules/package.json packages/rules/
COPY packages/sync/package.json packages/sync/
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm --filter @sentinel/db db:generate

RUN groupadd --system app && useradd --system --gid app --create-home app
USER app
ENV NODE_ENV=production
# Full workspace kept on purpose: the same image runs one-off tasks —
#   pnpm --filter @sentinel/db db:deploy:prod   (migrations, as the DB owner)
#   pnpm --filter @sentinel/db user:add:prod    (DSL provisioning)
CMD ["pnpm", "--filter", "@sentinel/sync", "worker:prod"]
