{
  "name": "@sentinel/sync",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e ../../.env -- vitest run",
    "worker": "dotenv -e ../../.env -- tsx src/worker.ts",
    "trigger": "dotenv -e ../../.env -- tsx src/trigger.ts",
    "sync:sandbox": "dotenv -e ../../.env -- tsx scripts/sync-sandbox.ts",
    "sync:sandbox:prod": "tsx scripts/sync-sandbox.ts",
    "worker:prod": "tsx src/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1092.0",
    "@sentinel/db": "workspace:*",
    "bullmq": "^5.66.5",
    "ioredis": "^5.9.1",
    "zod": "^4.1.12",
    "@sentinel/rules": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
