{
  "name": "@sentinel/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e ../../.env -- vitest run",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "user:add": "dotenv -e ../../.env -- tsx scripts/user-add.ts",
    "db:deploy:prod": "prisma migrate deploy",
    "user:add:prod": "tsx scripts/user-add.ts",
    "db:seed:prod": "tsx prisma/seed.ts",
    "app-role:prod": "tsx scripts/create-app-role.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.16.2",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
