// Sentinel Watch — database schema
//
// Every table carries tenant_id (school/trust) and is protected by row-level
// security enforced in the database (see the tenancy_rls migration). Policies
// default-deny: a connection sees nothing unless it has explicitly set either
// a tenant context (app.tenant_id) or the system context (app.context =
// 'system', used by auth flows and background jobs). Use dbForTenant() /
// systemDb from this package — never query with an unscoped client.

generator client {
  provider = "prisma-client-js"
  // "native" for local dev/CI; the Debian 12 target explicitly for the
  // container images, so the engine choice never depends on what the
  // Docker build stage happens to have installed.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A Multi-Academy Trust: the grouping a set of schools belongs to. Watch's
// second tenancy mode (spec 5.1). A trust does NOT carry pupil data itself —
// every child's record still lives under exactly one school (the Tenant).
//
// CTO-DECISION: MAT hierarchy shape. The simplest working version keeps the
// school as THE tenant (tenant_id stays the RLS key on every table, so the
// entire tested isolation foundation holds unchanged) and adds Trust purely as
// a grouping over school-tenants. A trust-level user reads by fanning out
// across the trust's schools, each through its own tenant RLS context — never
// a "see everything" path. A dedicated trust RLS context (app.trust_id) is the
// later hardening; it is not needed for the design-partner MVP.
model Trust {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  schools Tenant[]
  users   User[]

  @@map("trusts")
}

// A tenant is a school (Bennett Memorial, Rusthall Academy). Pupil data always
// belongs to exactly one tenant; tenant_id is the row-level-security key on
// every table. A tenant optionally belongs to a Trust (nullable trust_id) — a
// standalone single school has none.
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // The Multi-Academy Trust this school belongs to, if any. NULL for a
  // standalone single school (the demo's "Single school" tenancy mode).
  trustId   String?  @map("trust_id")
  // Wonde school identifier once the tenant is linked to a (sandbox or
  // production) school. Set by self-connect during onboarding (slice 3) or the
  // sync trigger CLI.
  wondeSchoolId String? @unique @map("wonde_school_id")
  // The linked Wonde school's display name and when it was connected — for the
  // onboarding surface; the id above is the key the sync jobs use.
  wondeSchoolName String?   @map("wonde_school_name")
  wondeConnectedAt DateTime? @map("wonde_connected_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trust              Trust?             @relation(fields: [trustId], references: [id])
  users              User[]
  pupils             Pupil[]
  attendanceRecords  AttendanceRecord[]
  behaviourIncidents BehaviourIncident[]
  attainmentRecords  AttainmentRecord[]
  syncRuns           SyncRun[]
  ruleExecutions     RuleExecution[]
  signals            Signal[]

  @@map("tenants")
}

// A versioned rule definition. Rules are implemented in code
// (packages/rules); this table records each (key, version) with its exact
// parameters so every signal points at the precise definition that produced
// it. The engine refuses to run if code params drift from the stored version
// without a version bump — versioning is enforced, not conventional.
// tenant_id is NULL for platform-wide definitions; per-school tuning can
// populate it later without schema change.
model RuleVersion {
  id          String   @id @default(cuid())
  tenantId    String?  @map("tenant_id")
  key         String
  version     Int
  name        String
  description String
  params      Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  signals Signal[]

  @@unique([key, version])
  @@map("rule_versions")
}

enum RuleExecutionStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// Execution log: one row per engine run per tenant. Stats record which rule
// versions ran and what they produced — the audit trail for the engine.
model RuleExecution {
  id         String              @id @default(cuid())
  tenantId   String              @map("tenant_id")
  status     RuleExecutionStatus @default(RUNNING)
  asOf       DateTime            @map("as_of")
  stats      Json?
  error      String?
  startedAt  DateTime            @default(now()) @map("started_at")
  finishedAt DateTime?           @map("finished_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  signals Signal[]

  @@index([tenantId, startedAt])
  @@map("rule_executions")
}

// Append-only audit trail: who read or changed what about a child's record,
// when, and why. Deliberately has NO foreign keys — audit history must
// survive the deletion of anything it references — and the migration creates
// no UPDATE or DELETE policies, so under FORCE row-level security not even
// the system context can rewrite or remove an entry.
model AuditEvent {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  pupilId    String?  @map("pupil_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([pupilId, createdAt])
  @@map("audit_events")
}

enum DecisionKind {
  CONFIRM
  DISMISS
  ESCALATE
}

// A DSL's decision on a signal — the safeguarding record at the heart of the
// human-in-the-loop principle. Append-only like audit_events: no foreign
// keys (the record outlives whatever it references) and no UPDATE/DELETE
// policies, so no connection can ever rewrite a decision.
model SignalDecision {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  signalId  String       @map("signal_id")
  pupilId   String       @map("pupil_id")
  userId    String       @map("user_id")
  kind      DecisionKind
  note      String?
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([signalId])
  @@index([pupilId, createdAt])
  @@map("signal_decisions")
}

// An AI-generated advisory narrative for a confirmed signal. Labelled as
// AI-generated in the schema itself (ai_generated), with the exact prompt
// version and model that produced it. Append-only like audit_events and
// signal_decisions: no foreign keys, no UPDATE/DELETE policies. Content is
// generated from pseudonymised data only and is strictly advisory — nothing
// reads a narrative to make a decision.
model SignalNarrative {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  signalId      String   @map("signal_id")
  pupilId       String   @map("pupil_id")
  content       String
  aiGenerated   Boolean  @default(true) @map("ai_generated")
  promptKey     String   @map("prompt_key")
  promptVersion Int      @map("prompt_version")
  modelId       String   @map("model_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([signalId, createdAt])
  @@index([tenantId, createdAt])
  @@map("signal_narratives")
}

// A case note a DSL records against a signal, optionally tagging colleagues at
// the school. Append-only like decisions and narratives: a safeguarding note,
// once written, is part of the record — no edits, no hard deletes. tagged_user_ids
// holds the ids of colleagues notified; the reveal of a pupil's identity is not
// recorded here but in the audit trail, so a note never carries a name.
model CaseNote {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  signalId      String   @map("signal_id")
  pupilId       String   @map("pupil_id")
  authorId      String   @map("author_id")
  body          String
  taggedUserIds String[] @map("tagged_user_ids")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([signalId, createdAt])
  @@index([tenantId, createdAt])
  @@map("case_notes")
}

enum CaseMessageDirection {
  OUTBOUND
  INBOUND // reserved for phase 2 (inbound safeguarding-mailbox capture)
}

enum CaseMessageStatus {
  SENT
  FAILED
}

// A communication threaded to a case (commercialisation slice 4: email mission
// control). Phase 1 records outbound mail a human reviewed and sent from the
// platform — the drafted referral or letter, threaded to the child's case, so
// the communication itself lives in the system ("nothing slips through the
// gaps"). Append-only: a safeguarding communication, once sent, is part of the
// record — never rewritten or removed (spec principle 3/4). Sealed on any list
// surface (the pupil is referenced by signal, shown sealed until a case
// reveal). Human-in-the-loop is structural: the machine drafts, the person
// sends — there is no auto-send.
model CaseMessage {
  id                String               @id @default(cuid())
  tenantId          String               @map("tenant_id")
  signalId          String               @map("signal_id")
  pupilId           String               @map("pupil_id")
  direction         CaseMessageDirection
  status            CaseMessageStatus    @default(SENT)
  // The template the draft came from (a CommType), if any.
  commType          String?              @map("comm_type")
  fromAddress       String               @map("from_address")
  toAddresses       String[]             @map("to_addresses")
  subject           String
  body              String
  // The user who sent it (null for inbound capture in phase 2).
  sentById          String?              @map("sent_by_id")
  // Provider thread + message ids, for phase-2 threading of replies.
  threadId          String?              @map("thread_id")
  providerMessageId String?              @map("provider_message_id")
  createdAt         DateTime             @default(now()) @map("created_at")

  @@index([signalId, createdAt])
  @@index([tenantId, createdAt])
  @@map("case_messages")
}

// Commercial billing for a Multi-Academy Trust (commercialisation slice 5).
// One account per trust; pricing is cost-per-pupil plus a flat fee per MAT.
// Billing is trust-level, not pupil data — it is reached only by a trust
// administrator through the system context, never by a school tenant, and its
// row-level-security policy enforces exactly that. Money is stored as integer
// pence to avoid floating-point drift.
//
// CTO-DECISION: the per-pupil rate is the commercial figure to confirm (the
// default here is provisional); the MAT fee is the agreed £50,000/year. Real
// Stripe wiring (customer + invoice objects) is stubbed behind an interface —
// the stripe_* ids are reserved for it.
model BillingAccount {
  id                   String   @id @default(cuid())
  trustId              String   @unique @map("trust_id")
  perPupilPencePerYear Int      @default(500) @map("per_pupil_pence_per_year")
  matFeePence          Int      @default(5000000) @map("mat_fee_pence")
  currency             String   @default("GBP")
  stripeCustomerId     String?  @map("stripe_customer_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("billing_accounts")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

// A metered billing period for a trust: the pupil count and the pricing that
// applied, with the computed lines frozen at snapshot time so a later price or
// roll change never rewrites history. The invoice lifecycle (draft → issued →
// paid) lives here; the amounts do not change once set.
model BillingSnapshot {
  id              String        @id @default(cuid())
  trustId         String        @map("trust_id")
  periodStart     DateTime      @map("period_start")
  periodEnd       DateTime      @map("period_end")
  pupilCount      Int           @map("pupil_count")
  perPupilPence   Int           @map("per_pupil_pence")
  matFeePence     Int           @map("mat_fee_pence")
  usagePence      Int           @map("usage_pence")
  totalPence      Int           @map("total_pence")
  currency        String
  invoiceStatus   InvoiceStatus @default(DRAFT) @map("invoice_status")
  stripeInvoiceId String?       @map("stripe_invoice_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([trustId, periodStart])
  @@map("billing_snapshots")
}

enum DocumentScope {
  ORG
  CASE
}

// A document in the Watch repository (spec 5.9). Two scopes: org-level (the
// vault — policies, records, generated reports) and case-level (documents
// filed against a signal, e.g. a drafted comm or a MASH response). Case
// documents carry the sealed pupil reference via signal/pupil ids, never a
// name. Not hard-deletable: the RLS migration grants SELECT/INSERT/UPDATE only,
// so a safeguarding document is never removed (spec principle 3), only
// superseded by status.
model Document {
  id        String        @id @default(cuid())
  tenantId  String        @map("tenant_id")
  scope     DocumentScope
  signalId  String?       @map("signal_id")
  pupilId   String?       @map("pupil_id")
  title     String
  // Referral, Letter, Note, Assessment, Record, Chronology, Policy, Report,
  // Return, Training. A free string, not an enum, so document kinds can grow
  // without a migration.
  type      String
  docDate   DateTime      @map("doc_date")
  status    String        @default("Filed")
  themes    String[]
  summary   String
  content   String
  generated Boolean       @default(false)
  source    String?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([tenantId, scope, docDate])
  @@index([signalId, createdAt])
  @@map("documents")
}

// An action on a case file (spec 5.7). The checklist is seeded from the case's
// recommended route when the file is opened; a DSL works through it. Toggleable
// (done flips), so RLS grants UPDATE, but no DELETE — a task is never removed.
model CaseTask {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  signalId  String   @map("signal_id")
  pupilId   String   @map("pupil_id")
  label     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([signalId, createdAt])
  @@index([tenantId, createdAt])
  @@map("case_tasks")
}

// A scheduled pastoral review on a case (spec 5.8). Append-only: a scheduled
// review is part of the record. attendees holds the tagged colleagues' ids.
model CaseReview {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  signalId     String   @map("signal_id")
  pupilId      String   @map("pupil_id")
  scheduledFor String   @map("scheduled_for")
  attendees    String[]
  note         String?
  createdById  String   @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([signalId, createdAt])
  @@index([tenantId, createdAt])
  @@map("case_reviews")
}

// A referral to the multi-agency safeguarding hub (spec 5.10 / step 10). One
// per case. The stage advances (submitted, chased, decided, re-referred), so
// RLS grants UPDATE; there is no DELETE. Watch never submits to MASH itself —
// the school submits; this records the lifecycle.
model Referral {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  signalId    String   @unique @map("signal_id")
  pupilId     String   @map("pupil_id")
  stage       String   @default("submitted")
  decision    String?
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId, createdAt])
  @@map("referrals")
}

// An event on a referral's timeline (spec 5.10). Append-only.
model ReferralEvent {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  referralId String   @map("referral_id")
  occurredOn String   @map("occurred_on")
  text       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([referralId, createdAt])
  @@map("referral_events")
}

// A task in a KCSIE component workspace (spec 5.13). component_key identifies
// which of the seven components. Toggleable, so RLS grants UPDATE; no DELETE.
model KcsieTask {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  componentKey String   @map("component_key")
  label        String
  done         Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([tenantId, componentKey])
  @@map("kcsie_tasks")
}

// Evidence attached to a KCSIE component (spec 5.13): a link to a vault
// document. Append-only.
model KcsieEvidence {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  componentKey String   @map("component_key")
  documentId   String   @map("document_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([tenantId, componentKey, documentId])
  @@map("kcsie_evidence")
}

// A logged call to the advisory LLM layer (spec 6 data model / step 15). Every
// advisory surface records the prompt key and version, a hash of the input
// (never the input itself, which is pseudonymised anyway), whether the output
// came from the model or the deterministic fallback, and the model id when the
// model answered. Append-only: the record of what was asked and where the
// answer came from is permanent. advisory is always true — this layer is never
// authoritative.
model LlmCall {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  surface       String
  signalId      String?  @map("signal_id")
  promptKey     String   @map("prompt_key")
  promptVersion Int      @map("prompt_version")
  inputHash     String   @map("input_hash")
  source        String
  modelId       String?  @map("model_id")
  advisory      Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([signalId, createdAt])
  @@map("llm_calls")
}

// The lifecycle is human-driven by design: the engine only ever creates or
// refreshes OPEN signals. Confirm / dismiss / escalate are DSL actions
// (build step 7) — nothing in the system auto-actions a signal.
enum SignalStatus {
  OPEN
  CONFIRMED
  DISMISSED
  ESCALATED
}

// A signal raised by the rules engine about one pupil. reasoning is the
// explainability contract: summary, computed metrics vs thresholds, and the
// underlying data points — no unexplained scores.
model Signal {
  id            String       @id @default(cuid())
  tenantId      String       @map("tenant_id")
  pupilId       String       @map("pupil_id")
  ruleVersionId String       @map("rule_version_id")
  executionId   String       @map("execution_id")
  status        SignalStatus @default(OPEN)
  severity      Int
  // A signal flagged serious (e.g. a disclosure) is escalation level 4 and
  // revealable regardless of the numeric severity (spec section 7).
  serious       Boolean      @default(false)
  title         String
  reasoning     Json
  windowStart   DateTime     @map("window_start") @db.Date
  windowEnd     DateTime     @map("window_end") @db.Date
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  pupil       Pupil         @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  ruleVersion RuleVersion   @relation(fields: [ruleVersionId], references: [id])
  execution   RuleExecution @relation(fields: [executionId], references: [id])

  @@index([tenantId, status])
  @@index([pupilId, status])
  @@map("signals")
}

enum SyncType {
  STUDENTS
  ATTENDANCE
  BEHAVIOUR
  ATTAINMENT
}

enum SyncStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

// One row per sync job execution — the audit trail for ingestion. Stats
// carry created/updated/skipped counts so idempotency is observable.
model SyncRun {
  id         String     @id @default(cuid())
  tenantId   String     @map("tenant_id")
  type       SyncType
  status     SyncStatus @default(QUEUED)
  stats      Json?
  error      String?
  queuedAt   DateTime   @default(now()) @map("queued_at")
  startedAt  DateTime?  @map("started_at")
  finishedAt DateTime?  @map("finished_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, type, queuedAt])
  @@map("sync_runs")
}

// A pupil on a school's roll. Pupil data always belongs to exactly one
// tenant — tenant_id is NOT NULL here, unlike platform users.
// Development data is synthetic only (see prisma/seed.ts) until DPAs are
// signed; wonde source-id mapping columns arrive with build step 4.
model Pupil {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  // Wonde student id — the idempotency key for the students sync job.
  wondeId           String?  @map("wonde_id")
  // Synthetic stand-in for the Unique Pupil Number format.
  upn               String   @unique
  firstName         String   @map("first_name")
  lastName          String   @map("last_name")
  yearGroup         Int      @map("year_group")
  registrationGroup String   @map("registration_group")
  dateOfBirth       DateTime @map("date_of_birth")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  attendanceRecords  AttendanceRecord[]
  behaviourIncidents BehaviourIncident[]
  attainmentRecords  AttainmentRecord[]
  signals            Signal[]

  @@unique([tenantId, wondeId])
  @@index([tenantId])
  @@index([tenantId, yearGroup])
  @@map("pupils")
}

enum AttendanceSession {
  AM
  PM
}

// One row per pupil per school session (AM/PM), UK-register style.
// Codes are a working subset of the DfE register codes:
//   "/" present  "L" late  "I" illness (authorised)  "M" medical (authorised)
//   "C" other authorised  "O" unauthorised  "N" no reason yet
// CTO-DECISION: full DfE code list and school-calendar modelling (term dates,
// holidays). Weekdays-only is the simplest working version for the MVP.
model AttendanceRecord {
  id         String            @id @default(cuid())
  tenantId   String            @map("tenant_id")
  pupilId    String            @map("pupil_id")
  // Wonde record id — idempotency key for synced rows (null for seed data).
  sourceId   String?           @map("source_id")
  date       DateTime          @db.Date
  session    AttendanceSession
  code       String
  present    Boolean
  authorised Boolean
  createdAt  DateTime          @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  pupil  Pupil  @relation(fields: [pupilId], references: [id], onDelete: Cascade)

  @@unique([pupilId, date, session])
  @@unique([tenantId, sourceId])
  @@index([tenantId, date])
  @@map("attendance_records")
}

// A recorded behaviour incident. Severity 1 (low) to 3 (serious).
model BehaviourIncident {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  pupilId     String   @map("pupil_id")
  // Wonde behaviour id + student id — idempotency key for synced rows.
  sourceId    String?  @map("source_id")
  date        DateTime @db.Date
  category    String
  severity    Int
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  pupil  Pupil  @relation(fields: [pupilId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceId])
  @@index([tenantId, date])
  @@index([pupilId, date])
  @@map("behaviour_incidents")
}

// A termly assessment result. Score is a standardised 0–100 scale.
// CTO-DECISION: real attainment modelling (key stages, subject grading
// schemes, teacher assessments vs tests). A flat standardised score is the
// simplest working version the rules engine can detect declines against.
model AttainmentRecord {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  pupilId    String   @map("pupil_id")
  // Wonde result id — idempotency key for synced rows (null for seed data).
  sourceId   String?  @map("source_id")
  subject    String
  assessedAt DateTime @map("assessed_at") @db.Date
  score      Int
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  pupil  Pupil  @relation(fields: [pupilId], references: [id], onDelete: Cascade)

  @@unique([pupilId, subject, assessedAt])
  @@unique([tenantId, sourceId])
  @@index([tenantId, assessedAt])
  @@map("attainment_records")
}

// How a user is scoped. A school DSL sees one school; a trust director sees
// across the schools of their trust (spec 5.1, escalation-level identity
// rules unchanged by this).
// CTO-DECISION: fuller RBAC (deputy DSL, pastoral, admin, per-permission
// grants). Two roles are the simplest working version that expresses the two
// tenancy modes the product actually has today.
enum UserRole {
  DSL
  DIRECTOR
  // A trust administrator: everything a director sees, plus in-product user
  // management (invite, change role, deactivate) for the trust's accounts.
  ADMIN
}

// Account status. Deactivation is soft and audited — accounts are never hard
// deleted, so the audit trail of who did what stays intact (principle 4).
enum UserStatus {
  ACTIVE
  DEACTIVATED
}

// A user of the platform (a school DSL, or a trust Director of Safeguarding).
// Auth is email magic link for MVP. The schema is deliberately provider-agnostic
// (no password column, no provider-specific columns) so WorkOS / school SSO can
// replace magic links later without a schema change: an SSO provider only needs
// to resolve to a User row by email.
model User {
  id        String   @id @default(cuid())
  email     String     @unique
  name      String?
  role      UserRole   @default(DSL)
  status    UserStatus @default(ACTIVE)
  // Set when the account is deactivated; the row is never deleted.
  deactivatedAt DateTime? @map("deactivated_at")
  // Exactly one of tenantId / trustId is set for an operational user:
  //   DSL      → tenant_id  (their school), trust_id NULL
  //   DIRECTOR → trust_id   (their trust),  tenant_id NULL
  // A director reads each of their trust's schools through that school's own
  // tenant RLS context (see @sentinel/db resolveAccessibleSchools); there is
  // no cross-tenant read path. NULL tenant_id + NULL trust_id = platform-level
  // user, visible only to the system context.
  tenantId  String?  @map("tenant_id")
  trustId   String?  @map("trust_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
  trust           Trust?           @relation(fields: [trustId], references: [id])
  magicLinkTokens MagicLinkToken[]
  sessions        Session[]

  @@index([tenantId])
  @@index([trustId])

  @@map("users")
}

// One-time magic link tokens. Only a SHA-256 hash of the token is stored;
// the raw token appears only in the emailed link. Tokens are single-use
// (consumed_at) and short-lived (expires_at).
model MagicLinkToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id")
  tenantId   String?   @map("tenant_id")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("magic_link_tokens")
}

// Server-side sessions. The cookie holds a random token; only its SHA-256 hash
// is stored here. Revocation is a soft operation (revoked_at) so sign-outs
// remain visible to the audit trail (full audit logging lands with build step 7).
model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  tenantId  String?   @map("tenant_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}
