// Sentinel Watch — database schema
//
// Every table carries tenant_id (school/trust) and is protected by row-level
// security enforced in the database (see the tenancy_rls migration). Policies
// default-deny: a connection sees nothing unless it has explicitly set either
// a tenant context (app.tenant_id) or the system context (app.context =
// 'system', used by auth flows and background jobs). Use dbForTenant() /
// systemDb from this package — never query with an unscoped client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A tenant is a school (Downlands, Patcham) or, later, a trust.
// CTO-DECISION: MAT hierarchy (trust → schools, MAT-level users spanning
// schools). Flat tenants are the simplest working version for the two
// design-partner schools; nesting can be added without breaking tenant_id.
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("tenants")
}

// A user of the platform (DSL, pastoral staff, MAT-level user).
// Auth is email magic link for MVP. The schema is deliberately provider-agnostic
// (no password column, no provider-specific columns) so WorkOS / school SSO can
// replace magic links later without a schema change: an SSO provider only needs
// to resolve to a User row by email.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  // CTO-DECISION: user roles (DSL / deputy / MAT-level / admin) and how they map
  // to permissions. Simplest working version: no role column yet; every signed-in
  // user is treated as a DSL for the design-partner MVP.
  // CTO-DECISION: tenant membership model (single school vs MAT-level users who
  // span schools). Nullable single tenant_id is the simplest working version.
  // NULL tenant_id = platform-level user, visible only to the system context.
  tenantId  String?  @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
  magicLinkTokens MagicLinkToken[]
  sessions        Session[]

  @@index([tenantId])

  @@map("users")
}

// One-time magic link tokens. Only a SHA-256 hash of the token is stored;
// the raw token appears only in the emailed link. Tokens are single-use
// (consumed_at) and short-lived (expires_at).
model MagicLinkToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id")
  tenantId   String?   @map("tenant_id")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("magic_link_tokens")
}

// Server-side sessions. The cookie holds a random token; only its SHA-256 hash
// is stored here. Revocation is a soft operation (revoked_at) so sign-outs
// remain visible to the audit trail (full audit logging lands with build step 7).
model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  tenantId  String?   @map("tenant_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}
